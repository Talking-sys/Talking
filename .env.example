# Talking — example environment. Copy to .env (gitignored). NEVER commit real secrets.
# Copyright (C) 2026 hateaboutyouone. Contact: hateaboutyou111@icloud.com

# --- Core ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=Talking
APP_CONTACT_EMAIL=hateaboutyou111@icloud.com
APP_DATA_DIR=./data
APP_CORS_ORIGINS=
APP_SECRET_KEY=
# Production requires APP_SECRET_KEY (≥32 chars). Empty in dev autogens data/secret.key.

# --- Auth (M10 stages 0–1 + phone). Never commit real values. ---
# local = single-user home Wi-Fi translator (default in dev/tests). accounts = cookies + CSRF.
# AUTH_MODE=local is refused when APP_ENV=production.
AUTH_MODE=local
PUBLIC_ORIGIN=
LOG_SALT=
DB_ENCRYPTION_KEY=
# SMS_PROVIDER=console is local/dev/tests only (refused when APP_ENV=production).
# Production: SMS_PROVIDER=twilio plus TWILIO_* (Verify SMS default; voice is fallback).
# vonage is a placeholder and is refused in production.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Comma-separated ISO country codes. Empty = all (do not leave empty in production).
SMS_COUNTRY_ALLOWLIST=
SMS_DEFAULT_REGION=

# --- Speech recognition (faster-whisper). Default large-v3 as specified;
# for phones/CPU set WHISPER_MODEL=base or small. Tests inject a fake STT. ---
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# --- Translation. Grok if XAI_API_KEY is set; otherwise free fallback (no key). ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-fast-non-reasoning
APP_TRANSLATE_PROVIDERS=grok,google,stub

# --- TTS. Default is browser Web Speech API (no server synth).
# Set APP_TTS_PROVIDERS=gtts for optional server-side gTTS (MIT, needs network).
# GPL extras (edge-tts, piper/espeak-ng) live in requirements-optional.txt and stay off. ---
APP_TTS=0
APP_TTS_PROVIDERS=

# --- Audio / VAD ---
APP_PAUSE_MS=800
APP_MAX_SEGMENT_S=18
APP_BUFFER_SECONDS=180

# --- Optional Postgres (Neon-compatible). Empty = local files/SQLite only. ---
DATABASE_URL=

# --- Optional Redis. Empty = in-process only. Unfurl cache uses Redis when set. ---
REDIS_URL=

# --- Link previews (unfurl). Empty / 0 = live fetch with SSRF guards. ---
UNFURL_STUB=0
UNFURL_TIMEOUT_S=8
UNFURL_MAX_BYTES=1048576
UNFURL_MAX_REDIRECTS=4
UNFURL_CACHE_TTL_S=86400
UNFURL_RATE_PER_MIN=20
CHAT_MSG_RATE_PER_MIN=10
# Telegram-like message edits. Window is seconds from original send (0 = unlimited).
CHAT_EDIT_WINDOW_S=172800
CHAT_EDIT_RATE_PER_MIN=20
# Groups: GPL cap 20. Trial cap 5 applies only when COMMERCIAL_API_URL is set.
CHAT_GROUP_MAX_MEMBERS=20
CHAT_GROUP_TRIAL_MAX_MEMBERS=5
CHAT_GROUP_INVITE_TTL_S=604800

# --- Optional S3-compatible archive (R2 / MinIO / AWS). Empty = local JSONL only. ---
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Chat notes (кружочки). Defaults match the owner spec; override in tests. ---
CHAT_VOICE_MAX_BYTES=8388608
CHAT_VIDEO_MAX_BYTES=26214400
CHAT_QUOTA_BYTES=524288000
CHAT_NOTE_MAX_MS=60000
CHAT_MSG_PER_MIN=10
CHAT_UPLOAD_PER_MIN=20
CHAT_PLAY_TOKEN_TTL=600
CHAT_DOWNLOAD_TOKEN_TTL=120
CHAT_TRANSCRIBE=1
# On-demand premium transcription (default). Set to 1 only to restore PR #3 auto-STT on upload.
CHAT_TRANSCRIBE_ON_UPLOAD=0
# lock = locked button + upsell; teaser = locked + hint copy; hidden = no button. Free users never run STT.
CHAT_TRANSCRIBE_FREE_MODE=lock
CHAT_TRANSCRIBE_PER_MIN=8
CHAT_TRANSCRIBE_MAX_MS=60000
CHAT_RETENTION_SECONDS=0
# faster-whisper = local, private. openai-compatible sends audio off-box (off unless URL+key set).
CHAT_STT_PROVIDER=faster-whisper
CHAT_STT_API_URL=
CHAT_STT_API_KEY=
CHAT_STT_API_MODEL=whisper-1

# --- Voice translation (hold-to-talk live + record). Live is free unless gated. ---
VOICE_TRANSLATE_LIVE_PREMIUM=0
VOICE_TRANSLATE_LIVE_MAX_S=120
VOICE_TRANSLATE_PARTIAL_INTERVAL_S=0.8
VOICE_TRANSLATE_RECORD_MAX_MS=60000
VOICE_TRANSLATE_RECORD_PER_MIN=20

# --- Proprietary commercial modules (separate repo). Empty = local stubs, core still runs. ---
COMMERCIAL_API_URL=
COMMERCIAL_API_TOKEN=
COMMERCIAL_WEBHOOK_SECRET=
# Dev/test only. Ignored when APP_ENV=production. Example: voice_transcription or * 
COMMERCIAL_DEV_ENTITLEMENTS=
COMMERCIAL_DEV_PREMIUM=0
COMMERCIAL_ENTITLEMENT_CACHE_TTL=60
COMMERCIAL_API_TIMEOUT=5

# --- Game embed SDK (/api/sdk/v1). Empty = SDK endpoints disabled (503).
# Format: app_id:secret,other_app:other_secret   — never commit real keys.
# Example local value (NOT a production secret): demo:change-me
SDK_API_KEYS=
SDK_RATE_LIMIT_PER_MIN=60
SDK_MAX_TEXT_CHARS=4000
SDK_MAX_AUDIO_BYTES=5242880
